{
  "info": {
    "name": "Talent Pathway API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "provider_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "provider_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": { "method": "GET", "url": "{{base_url}}/api/health" }
    },
    {
      "name": "Auth - Register (provider)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ramesh Kulkarni\",\n  \"email\": \"ramesh@example.com\",\n  \"phone\": \"+919849021134\",\n  \"password\": \"password123\",\n  \"category\": \"Electrician\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ramesh@example.com\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "Auth - Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }],
        "url": "{{base_url}}/api/auth/me"
      }
    },
    {
      "name": "Provider - Get Profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }],
        "url": "{{base_url}}/api/provider/profile"
      }
    },
    {
      "name": "Provider - Update Profile",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{provider_token}}" }
        ],
        "url": "{{base_url}}/api/provider/profile",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"city\": \"Hyderabad\",\n  \"state\": \"Telangana\",\n  \"experienceYears\": 9,\n  \"skills\": [\"Wiring\", \"Inverter Setup\"],\n  \"bio\": \"Licensed electrician with 9 years of experience.\",\n  \"languages\": [\"Telugu\", \"Hindi\", \"English\"]\n}"
        }
      }
    },
    {
      "name": "Provider - Upload Document",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }],
        "url": "{{base_url}}/api/provider/documents",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "label", "value": "Aadhaar Card", "type": "text" },
            { "key": "document", "type": "file", "src": "" }
          ]
        }
      }
    },
    {
      "name": "Provider - Submit Application",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }],
        "url": "{{base_url}}/api/provider/submit"
      }
    },
    {
      "name": "Admin - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"CHANGE_ME_STRONG_PASSWORD\"\n}"
        }
      }
    },
    {
      "name": "Admin - List Providers",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
        "url": "{{base_url}}/api/admin/providers?status=submitted"
      }
    },
    {
      "name": "Admin - Get Provider Detail",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
        "url": "{{base_url}}/api/admin/providers/{{provider_id}}"
      }
    },
    {
      "name": "Admin - Update Provider Status",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "url": "{{base_url}}/api/admin/providers/{{provider_id}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"approved\",\n  \"remarks\": \"\"\n}"
        }
      }
    }
  ]
}
